# Copy to server/.env and replace placeholders with local values.
MONGO_URI=mongodb://127.0.0.1:27017/music-hub
PORT=5000
YOUTUBE_API_KEY=replace_me
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
SPOTIFY_CLIENT_ID=replace_me
SPOTIFY_CLIENT_SECRET=replace_me

# Documented for future configuration; these are not currently consumed by the server.
CLIENT_ORIGIN=http://localhost:3000
AUDIO_DIR=../temp-audio
API_TOKEN=replace_me
